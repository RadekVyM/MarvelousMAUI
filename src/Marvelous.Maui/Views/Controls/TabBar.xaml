<?xml version="1.0" encoding="utf-8" ?>
<Grid
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Marvelous.Maui.Views.Controls"
    xmlns:sb="clr-namespace:SimpleToolkit.SimpleButton;assembly=SimpleToolkit.SimpleButton"
    x:Class="Marvelous.Maui.Views.Controls.TabBar"

    SafeAreaEdges="None">

    <Grid.Resources>
        <Style TargetType="controls:Icon">
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="22" />
            <Setter Property="HeightRequest" Value="22" />
        </Style>
        <Style x:Key="TabButton" TargetType="sb:SimpleButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Grid.Resources>
    
    <Grid
        x:Name="rootGrid"
        RowDefinitions="10, 70, auto"
        ColumnDefinitions="*, *, *, *, *"
        SafeAreaEdges="None">
        <ContentView
            x:Name="backgroundRect"
            Grid.Row="1" Grid.ColumnSpan="5" Grid.RowSpan="2"
            SafeAreaEdges="None" />

        <GraphicsView
            x:Name="graphicsView"
            Grid.Row="1" Grid.ColumnSpan="5"
            Background="Transparent" />

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalOptions="Center" VerticalOptions="Start">
            <BoxView
                x:Name="wonderBoxView"
                Color="White"
                CornerRadius="33"
                HeightRequest="65" WidthRequest="65"
                HorizontalOptions="Center" VerticalOptions="Center" />
            <sb:SimpleButton
                x:Name="wonderButton"
                HeightRequest="58" WidthRequest="58"
                Clicked="WonderButtonClicked"
                HorizontalOptions="Center" VerticalOptions="Center">
                <sb:SimpleButton.Clip>
                    <EllipseGeometry Center="29, 29" RadiusX="27" RadiusY="27" />
                </sb:SimpleButton.Clip>
                <Image
                    x:Name="wonderImage"
                    Aspect="AspectFill" />
            </sb:SimpleButton>
        </Grid>

        <sb:SimpleButton
            Style="{StaticResource TabButton}"
            Grid.Column="1" Grid.Row="1"
            Clicked="TabButtonClicked">
            <controls:Icon />
        </sb:SimpleButton>

        <sb:SimpleButton
            Style="{StaticResource TabButton}"
            Grid.Column="2" Grid.Row="1"
            Clicked="TabButtonClicked">
            <controls:Icon />
        </sb:SimpleButton>

        <sb:SimpleButton
            Style="{StaticResource TabButton}"
            Grid.Column="3" Grid.Row="1"
            Clicked="TabButtonClicked">
            <controls:Icon />
        </sb:SimpleButton>

        <sb:SimpleButton
            Style="{StaticResource TabButton}"
            Grid.Column="4" Grid.Row="1"
            Clicked="TabButtonClicked">
            <controls:Icon />
        </sb:SimpleButton>
    </Grid>
</Grid>

<?xml version="1.0" encoding="utf-8" ?>
<Grid
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Marvelous.Maui.Views.Controls"
    xmlns:sb="clr-namespace:SimpleToolkit.SimpleButton;assembly=SimpleToolkit.SimpleButton"
    x:Class="Marvelous.Maui.Views.Controls.WonderSectionTitleView"

    SafeAreaEdges="None">
    <GraphicsView
        x:Name="graphicsView"
        Background="Transparent" />
    <controls:Icon
        x:Name="icon"
        TintColor="{StaticResource PrimaryColor}"
        HorizontalOptions="Center" VerticalOptions="Center"
        Margin="0, 32, 0, 0"
        HeightRequest="30" WidthRequest="30" />
</Grid>